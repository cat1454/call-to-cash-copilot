NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Production API origin allowlist (scheme + hostname only, no trailing slash).
WEB_ORIGIN=

# Phase 4 PostgreSQL runs on a non-default host port to avoid colliding with a
# developer's existing PostgreSQL service. These credentials are local-only.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://call_to_cash:call_to_cash@127.0.0.1:55432/call_to_cash?schema=public

# Demo mode is explicit and preserves real domain guards once implemented.
DEMO_MODE=true
PAYMENT_PROVIDER=mock
# Phase 8 opt-in provider: set PAYMENT_PROVIDER=solana_devnet and configure a
# public recipient address. No private key is used or accepted by the server.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RECIPIENT_PUBLIC_KEY=
SOLANA_DEMO_AMOUNT_LAMPORTS=1000000
SOLANA_PAYMENT_LABEL=Call-to-Cash Demo
VOICE_PROVIDER=replay
# Phase 9 live adapter. Keep replay for deterministic fallback.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Separate server-only secrets. Never substitute one for the other.
AGORA_PROVIDER_EVENT_SECRET=
# Shared only by the API and the isolated RTM relay control plane.
AGORA_RTM_RELAY_CONTROL_SECRET=
AGORA_RTM_RELAY_URL=http://127.0.0.1:3011
AGORA_RTM_RELAY_UID=9002
AGORA_NCS_WEBHOOK_SECRET=
AGORA_TOKEN_TTL_SECONDS=600
AGORA_AGENT_UID=9001
AGORA_CAI_AGENT_NAME=call-to-cash-agent
AGORA_API_BASE_URL=https://api.agora.io
# Server-only JSON sent to CAI; never expose it through a VITE_ variable.
AGORA_CAI_PROPERTIES_JSON=
AI_PROVIDER=deterministic
# Phase 10 backend-only extraction. Never use a VITE_ prefix for these values.
AI_EXTRACTION_MODE=hybrid
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
AI_EXTRACTION_TIMEOUT_MS=1500
AI_EXTRACTION_PROMPT_VERSION=CTC-BOOKING-EXTRACTION-V1

# Phase 6: Structured logging. Pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Phase 6: Per-IP rate limit (requests per minute). Set to 0 to disable in local dev.
RATE_LIMIT_MAX=100

# Vite exposes only VITE_-prefixed values to the browser.
# VITE_API_BASE_URL controls whether the web app uses the real API or mock simulation.
# When set and the API responds to /health, the web adapter switches to API mode.
VITE_DEMO_MODE=true
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_VOICE_PROVIDER=replay
