{
  "name": "@call-to-cash/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fastify orchestration boundary for the Call-to-Cash Risk Copilot.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/app.test.ts src/modules/call-session/commands/append-transcript-turn.test.ts src/modules/call-session/replay/replay-extractor.test.ts src/modules/voice-session/live-transcript-relay-client.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@call-to-cash/ai": "workspace:*",
    "@call-to-cash/agora": "workspace:*",
    "@call-to-cash/config": "workspace:*",
    "@call-to-cash/db": "workspace:*",
    "@call-to-cash/domain": "workspace:*",
    "@call-to-cash/shared": "workspace:*",
    "@call-to-cash/solana": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@solana/web3.js": "^1.98.4",
    "ajv": "^8.20.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  }
}
