generator client {
  provider = "prisma-client"
  output   = "../packages/db/src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OPERATOR
  PROVIDER_ADMIN
  SYSTEM
}

enum CallStatus {
  CREATED
  ACTIVE
  ENDED
  FAILED
  CANCELLED
}

enum CallPurpose {
  BOOKING
}

enum CallSourceMode {
  LIVE_AGORA
  TRANSCRIPT_REPLAY
  DEMO
}

enum ConsentType {
  RECORDING
  ANALYSIS
  TRAINING
}

enum ConsentStatus {
  GRANTED
  REVOKED
  DECLINED
}

enum ConsentCaptureMethod {
  WEB_MODAL
  VOICE_CONFIRMATION
  OPERATOR
}

enum TranscriptSpeaker {
  CUSTOMER
  AGENT
  OPERATOR
  SYSTEM
}

enum TranscriptSource {
  AGORA
  REPLAY
  MANUAL
}

enum ExtractionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum PaymentGateStatus {
  LOCKED
  READY_FOR_CONFIRMATION
  UNLOCKED
  MANUAL_REVIEW_REQUIRED
}

enum RiskNextAction {
  ASK_CLARIFICATION
  HOLD
  ASK_CONFIRMATION
  OPEN
  BLOCK
  HANDOFF
  RENDER_UPDATED_AGREEMENT
  ISSUE_RECEIPT
  MANUAL_REVIEW
}

enum TripDepartureStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  CANCELLED
}

enum InventoryHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum BookingStatus {
  DRAFT
  FIELDS_PARTIAL
  BOOKING_DRAFT_READY
  AGREEMENT_READY
  AGREEMENT_LOCKED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  BOOKING_CONFIRMED
  RECEIPT_ISSUED
  CANCELLED
  MANUAL_REVIEW_REQUIRED
  EXPIRED
}

enum Currency {
  VND
}

enum AgreementStatus {
  DRAFT
  READY
  LOCKED
  SUPERSEDED
  EXPIRED
}

enum ConfirmationMethod {
  VOICE
  WEB
  OPERATOR
}

enum PaymentIntentStatus {
  NOT_CREATED
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REJECTED
  MANUAL_REVIEW_REQUIRED
  CANCELLED
}

enum PaymentChain {
  MOCK
  SOLANA_DEVNET
  SOLANA_MAINNET
}

enum PaymentTransactionStatus {
  OBSERVED
  VALIDATING
  CONFIRMED
  REJECTED
  FAILED
}

enum PaymentAnchorType {
  SOLANA_MEMO
  SOLANA_REFERENCE
  SERVER_ATTESTATION
}

enum ProofStatus {
  PENDING
  MATCH
  MISMATCH
  UNAVAILABLE
}

enum ReceiptStatus {
  NOT_CREATED
  ISSUED
  VERIFIED_MATCH
  MISMATCH
  MANUAL_REVIEW
}

enum ObjectAssetKind {
  RAW_AUDIO
  RECORDING
  REDACTED_TRANSCRIPT_EXPORT
  EVIDENCE_ATTACHMENT
}

enum StorageProvider {
  MINIO
  S3
}

enum AuditActorType {
  USER
  OPERATOR
  SYSTEM
  WEBHOOK
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  publicId           String          @unique @map("public_id")
  role               UserRole
  displayName        String?         @map("display_name")
  phoneE164Encrypted String?         @map("phone_e164_encrypted")
  phoneMasked        String?         @map("phone_masked")
  walletAddress      String?         @map("wallet_address")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  customerCalls      CallSession[]   @relation("CallCustomer")
  operatorCalls      CallSession[]   @relation("CallOperator")
  consentRecords     ConsentRecord[]
  customerBookings   Booking[]       @relation("BookingCustomer")
  providerBookings   Booking[]       @relation("BookingProvider")

  @@map("users")
}

model TripDeparture {
  id                  String              @id @default(uuid()) @db.Uuid
  publicId            String              @unique @map("public_id")
  routeCode           String              @map("route_code")
  routeFrom           String              @map("route_from")
  routeTo             String              @map("route_to")
  departureAtUtc      DateTime            @map("departure_at_utc") @db.Timestamptz(3)
  departureTimezone   String              @map("departure_timezone")
  capacity            Int
  operationalStatus   TripDepartureStatus @default(SCHEDULED) @map("operational_status")
  currency            Currency            @default(VND)
  farePerSeatMinor    Int                 @map("fare_per_seat_minor")
  depositAmountMinor  Int                 @map("deposit_amount_minor")
  pricePolicyVersion  String              @map("price_policy_version")
  refundPolicyVersion String              @map("refund_policy_version")
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings            Booking[]
  inventoryHolds      InventoryHold[]

  @@unique([routeCode, departureAtUtc])
  @@index([routeFrom, routeTo, departureAtUtc])
  @@index([operationalStatus, departureAtUtc])
  @@map("trip_departures")
}

model CallSession {
  id                    String              @id @default(uuid()) @db.Uuid
  publicId              String              @unique @map("public_id")
  customerId            String?             @map("customer_id") @db.Uuid
  operatorId            String?             @map("operator_id") @db.Uuid
  bookingId             String?             @unique @map("booking_id") @db.Uuid
  status                CallStatus          @default(CREATED)
  channelName           String              @unique @map("channel_name")
  purpose               CallPurpose         @default(BOOKING)
  startedAt             DateTime?           @map("started_at") @db.Timestamptz(3)
  endedAt               DateTime?           @map("ended_at") @db.Timestamptz(3)
  audioRecordingEnabled Boolean             @default(false) @map("audio_recording_enabled")
  analysisEnabled       Boolean             @default(false) @map("analysis_enabled")
  sourceMode            CallSourceMode      @map("source_mode")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer              User?               @relation("CallCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  operator              User?               @relation("CallOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  booking               Booking?            @relation("CallCurrentBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  originatedBooking     Booking?            @relation("BookingOriginCall")
  consentRecords        ConsentRecord[]
  transcriptTurns       TranscriptTurn[]
  bookingExtractions    BookingExtraction[]
  riskAssessments       RiskAssessment[]
  objectAssets          ObjectAsset[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("call_sessions")
}

model ConsentRecord {
  id             String               @id @default(uuid()) @db.Uuid
  callSessionId  String               @map("call_session_id") @db.Uuid
  userId         String?              @map("user_id") @db.Uuid
  consentType    ConsentType          @map("consent_type")
  status         ConsentStatus
  policyVersion  String               @map("policy_version")
  capturedVia    ConsentCaptureMethod @map("captured_via")
  evidenceTurnId String?              @map("evidence_turn_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  callSession    CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  evidenceTurn   TranscriptTurn?      @relation(fields: [evidenceTurnId], references: [id], onDelete: SetNull)

  @@index([callSessionId, consentType, createdAt])
  @@map("consent_records")
}

model TranscriptTurn {
  id                  String            @id @default(uuid()) @db.Uuid
  publicId            String            @unique @map("public_id")
  callSessionId       String            @map("call_session_id") @db.Uuid
  providerEventId     String?           @map("provider_event_id")
  sequenceNo          Int               @map("sequence_no")
  speaker             TranscriptSpeaker
  contentRedacted     String            @map("content_redacted")
  contentEncrypted    String?           @map("content_encrypted")
  language            String
  isFinal             Boolean           @map("is_final")
  sttConfidence       Decimal?          @map("stt_confidence") @db.Decimal(5, 4)
  startedAt           DateTime?         @map("started_at") @db.Timestamptz(3)
  endedAt             DateTime?         @map("ended_at") @db.Timestamptz(3)
  source              TranscriptSource
  supersedesTurnId    String?           @map("supersedes_turn_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  callSession         CallSession       @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  supersedesTurn      TranscriptTurn?   @relation("TranscriptRevisions", fields: [supersedesTurnId], references: [id], onDelete: SetNull)
  supersededByTurns   TranscriptTurn[]  @relation("TranscriptRevisions")
  consentEvidence     ConsentRecord[]
  confirmedAgreements Agreement[]

  @@unique([callSessionId, sequenceNo])
  @@unique([callSessionId, providerEventId])
  @@index([callSessionId, createdAt])
  @@map("transcript_turns")
}

model BookingExtraction {
  id                String           @id @default(uuid()) @db.Uuid
  publicId          String           @unique @map("public_id")
  callSessionId     String           @map("call_session_id") @db.Uuid
  sourceTurnFrom    Int              @map("source_turn_from")
  sourceTurnTo      Int              @map("source_turn_to")
  extractionVersion String           @map("extraction_version")
  payload           Json
  fieldConfidence   Json             @map("field_confidence")
  missingFields     Json             @default("[]") @map("missing_fields")
  contradictions    Json             @default("[]")
  status            ExtractionStatus @default(PROPOSED)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  callSession       CallSession      @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([callSessionId, createdAt])
  @@map("booking_extractions")
}

model RiskAssessment {
  id                    String            @id @default(uuid()) @db.Uuid
  publicId              String            @unique @map("public_id")
  callSessionId         String?           @map("call_session_id") @db.Uuid
  bookingId             String?           @map("booking_id") @db.Uuid
  assessmentVersion     Int               @map("assessment_version")
  policyVersion         String            @map("policy_version")
  completenessScore     Int               @map("completeness_score")
  disputeRiskScore      Int               @map("dispute_risk_score")
  paymentReadinessScore Int               @map("payment_readiness_score")
  agentQualityScore     Int?              @map("agent_quality_score")
  gateDecision          PaymentGateStatus @map("gate_decision")
  nextAction            RiskNextAction    @map("next_action")
  reasonCodes           Json              @default("[]") @map("reason_codes")
  evidence              Json              @default("[]")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  callSession           CallSession?      @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  booking               Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, assessmentVersion])
  @@unique([bookingId, assessmentVersion])
  @@index([callSessionId, createdAt])
  @@index([bookingId, createdAt])
  @@map("risk_assessments")
}

model Booking {
  id                     String           @id @default(uuid()) @db.Uuid
  publicId               String           @unique @map("public_id")
  callSessionId          String?          @unique @map("call_session_id") @db.Uuid
  customerId             String?          @map("customer_id") @db.Uuid
  providerId             String?          @map("provider_id") @db.Uuid
  tripDepartureId        String?          @map("trip_departure_id") @db.Uuid
  status                 BookingStatus    @default(DRAFT)
  routeFrom              String?          @map("route_from")
  routeTo                String?          @map("route_to")
  departureAtUtc         DateTime?        @map("departure_at_utc") @db.Timestamptz(3)
  departureTimezone      String           @default("Asia/Ho_Chi_Minh") @map("departure_timezone")
  passengerCount         Int?             @map("passenger_count")
  pickupPointEncrypted   String?          @map("pickup_point_encrypted")
  pickupPointDisplay     String?          @map("pickup_point_display")
  contactPhoneEncrypted  String?          @map("contact_phone_encrypted")
  contactPhoneMasked     String?          @map("contact_phone_masked")
  currency               Currency         @default(VND)
  totalAmountMinor       Int?             @map("total_amount_minor")
  depositAmountMinor     Int?             @map("deposit_amount_minor")
  refundPolicyVersion    String?          @map("refund_policy_version")
  inventoryHoldExpiresAt DateTime?        @map("inventory_hold_expires_at") @db.Timestamptz(3)
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  callSession            CallSession?     @relation("BookingOriginCall", fields: [callSessionId], references: [id], onDelete: SetNull)
  currentForCall         CallSession?     @relation("CallCurrentBooking")
  customer               User?            @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  provider               User?            @relation("BookingProvider", fields: [providerId], references: [id], onDelete: SetNull)
  tripDeparture          TripDeparture?   @relation(fields: [tripDepartureId], references: [id], onDelete: SetNull)
  inventoryHolds         InventoryHold[]
  riskAssessments        RiskAssessment[]
  agreements             Agreement[]
  paymentIntents         PaymentIntent[]
  proofRecords           ProofRecord[]
  trustReceipts          TrustReceipt[]
  objectAssets           ObjectAsset[]

  @@index([customerId, createdAt])
  @@index([status, departureAtUtc])
  @@index([tripDepartureId])
  @@map("bookings")
}

model InventoryHold {
  id             String              @id @default(uuid()) @db.Uuid
  publicId       String              @unique @map("public_id")
  departureId    String              @map("departure_id") @db.Uuid
  bookingId      String              @map("booking_id") @db.Uuid
  quantity       Int
  status         InventoryHoldStatus @default(ACTIVE)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  idempotencyKey String              @unique @map("idempotency_key")
  releasedAt     DateTime?           @map("released_at") @db.Timestamptz(3)
  consumedAt     DateTime?           @map("consumed_at") @db.Timestamptz(3)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  departure      TripDeparture       @relation(fields: [departureId], references: [id], onDelete: Restrict)
  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agreements     Agreement[]

  @@index([departureId, status, expiresAt])
  @@index([bookingId, status])
  @@map("inventory_holds")
}

model Agreement {
  id                         String              @id @default(uuid()) @db.Uuid
  publicId                   String              @unique @map("public_id")
  bookingId                  String              @map("booking_id") @db.Uuid
  inventoryHoldId            String              @map("inventory_hold_id") @db.Uuid
  version                    Int
  status                     AgreementStatus     @default(DRAFT)
  canonicalPayload           Json                @map("canonical_payload")
  payloadHashSha256          String              @map("payload_hash_sha256") @db.Char(64)
  policyVersion              String              @map("policy_version")
  explicitConfirmationMethod ConfirmationMethod? @map("explicit_confirmation_method")
  confirmedTurnId            String?             @map("confirmed_turn_id") @db.Uuid
  confirmedAt                DateTime?           @map("confirmed_at") @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  booking                    Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryHold              InventoryHold       @relation(fields: [inventoryHoldId], references: [id], onDelete: Restrict)
  confirmedTurn              TranscriptTurn?     @relation(fields: [confirmedTurnId], references: [id], onDelete: SetNull)
  paymentIntents             PaymentIntent[]
  proofRecords               ProofRecord[]

  @@unique([bookingId, version])
  @@index([bookingId, status])
  @@map("agreements")
}

model PaymentIntent {
  id              String               @id @default(uuid()) @db.Uuid
  publicId        String               @unique @map("public_id")
  bookingId       String               @map("booking_id") @db.Uuid
  agreementId     String               @map("agreement_id") @db.Uuid
  status          PaymentIntentStatus  @default(CREATED)
  currency        Currency             @default(VND)
  amountMinor     Int                  @map("amount_minor")
  recipientWallet String               @map("recipient_wallet")
  tokenMint       String?              @map("token_mint")
  solanaReference String               @unique @map("solana_reference")
  memoReference   String               @map("memo_reference")
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(3)
  idempotencyKey  String               @unique @map("idempotency_key")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agreement       Agreement            @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  transactions    PaymentTransaction[]
  trustReceipt    TrustReceipt?

  @@index([bookingId, status])
  @@index([agreementId, status])
  @@map("payment_intents")
}

model PaymentTransaction {
  id                      String                   @id @default(uuid()) @db.Uuid
  paymentIntentId         String                   @map("payment_intent_id") @db.Uuid
  chain                   PaymentChain
  txSignature             String                   @unique @map("tx_signature")
  slot                    BigInt?                  @db.BigInt
  submittedAt             DateTime?                @map("submitted_at") @db.Timestamptz(3)
  verifiedAt              DateTime?                @map("verified_at") @db.Timestamptz(3)
  observedAmountMinor     Int?                     @map("observed_amount_minor")
  observedRecipientWallet String?                  @map("observed_recipient_wallet")
  observedReference       String?                  @map("observed_reference")
  verificationStatus      PaymentTransactionStatus @default(OBSERVED) @map("verification_status")
  rejectionReasonCode     String?                  @map("rejection_reason_code")
  rawChainMetadata        Json?                    @map("raw_chain_metadata")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  paymentIntent           PaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  proofRecord             ProofRecord?

  @@index([paymentIntentId, createdAt])
  @@map("payment_transactions")
}

model ProofRecord {
  id                   String              @id @default(uuid()) @db.Uuid
  publicId             String              @unique @map("public_id")
  bookingId            String              @map("booking_id") @db.Uuid
  agreementId          String              @map("agreement_id") @db.Uuid
  paymentTransactionId String?             @unique @map("payment_transaction_id") @db.Uuid
  proofHashSha256      String              @map("proof_hash_sha256") @db.Char(64)
  anchorType           PaymentAnchorType   @map("anchor_type")
  anchorValue          String              @map("anchor_value")
  verificationStatus   ProofStatus         @default(PENDING) @map("verification_status")
  verifiedAt           DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  booking              Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agreement            Agreement           @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  trustReceipt         TrustReceipt?

  @@index([bookingId, createdAt])
  @@index([agreementId])
  @@map("proof_records")
}

model TrustReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @map("public_id")
  bookingId       String        @map("booking_id") @db.Uuid
  paymentIntentId String        @unique @map("payment_intent_id") @db.Uuid
  proofRecordId   String?       @unique @map("proof_record_id") @db.Uuid
  status          ReceiptStatus @default(ISSUED)
  receiptPayload  Json          @map("receipt_payload")
  issuedAt        DateTime      @map("issued_at") @db.Timestamptz(3)
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  proofRecord     ProofRecord?  @relation(fields: [proofRecordId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("trust_receipts")
}

model ObjectAsset {
  id              String          @id @default(uuid()) @db.Uuid
  callSessionId   String?         @map("call_session_id") @db.Uuid
  bookingId       String?         @map("booking_id") @db.Uuid
  kind            ObjectAssetKind
  storageProvider StorageProvider @map("storage_provider")
  bucket          String
  objectKey       String          @map("object_key")
  checksumSha256  String?         @map("checksum_sha256") @db.Char(64)
  contentType     String          @map("content_type")
  sizeBytes       BigInt          @map("size_bytes") @db.BigInt
  retentionUntil  DateTime        @map("retention_until") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  callSession     CallSession?    @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([storageProvider, bucket, objectKey])
  @@index([callSessionId, createdAt])
  @@index([bookingId, createdAt])
  @@index([retentionUntil, deletedAt])
  @@map("object_assets")
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorId       String?        @map("actor_id")
  action        String
  aggregateType String         @map("aggregate_type")
  aggregateId   String         @map("aggregate_id")
  requestId     String?        @map("request_id")
  eventId       String?        @map("event_id")
  beforeState   Json?          @map("before_state")
  afterState    Json?          @map("after_state")
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId, createdAt])
  @@index([requestId])
  @@index([eventId])
  @@map("audit_logs")
}
