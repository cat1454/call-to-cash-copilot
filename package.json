{
  "name": "call-to-cash-risk-copilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @call-to-cash/api dev",
    "dev:web": "pnpm --filter @call-to-cash/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test tests/workspaceStructure.test.js && turbo run test",
    "format": "prettier --write \"apps/api/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.js\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"prettier.config.mjs\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"apps/api/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.js\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"prettier.config.mjs\" \".github/**/*.{yml,yaml}\"",
    "preview": "pnpm --filter @call-to-cash/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "pnpm": "11.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "2.9.18",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
