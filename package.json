{
  "name": "call-to-cash-risk-copilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @call-to-cash/api dev",
    "dev:web": "pnpm --filter @call-to-cash/web dev",
    "dev:rtm-relay": "pnpm --filter @call-to-cash/rtm-relay exec tsx src/server.ts",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "demo:smoke:cold": "node scripts/demo-smoke.mjs --cold-start",
    "test:preflight": "node --test scripts/demo-preflight.test.mjs scripts/demo-smoke.test.mjs",
    "db:generate": "pnpm --filter @call-to-cash/db prisma:generate",
    "db:validate": "pnpm --filter @call-to-cash/db prisma:validate",
    "db:migrate:dev": "pnpm --filter @call-to-cash/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @call-to-cash/db migrate:deploy",
    "db:migrate:status": "pnpm --filter @call-to-cash/db migrate:status",
    "db:seed": "pnpm --filter @call-to-cash/db seed",
    "db:studio": "pnpm --filter @call-to-cash/db studio",
    "prebuild": "pnpm install --frozen-lockfile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test tests/workspaceStructure.test.js tests/packageRuntimeExports.test.js && turbo run test",
    "format": "prettier --write \"apps/api/**/*.{ts,json}\" \"apps/rtm-relay/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.js\" \"prisma.config.ts\" \"prisma/seed.ts\" \"compose.yaml\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"prettier.config.mjs\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"apps/api/**/*.{ts,json}\" \"apps/rtm-relay/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.js\" \"prisma.config.ts\" \"prisma/seed.ts\" \"compose.yaml\" \"package.json\" \"turbo.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"prettier.config.mjs\" \".github/**/*.{yml,yaml}\"",
    "preview": "pnpm --filter @call-to-cash/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "ajv": "6.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "graceful-fs": "4.2.11",
    "pnpm": "10.34.4",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "proper-lockfile": "4.1.2",
    "retry": "0.12.0",
    "signal-exit": "3.0.7",
    "tsx": "^4.0.0",
    "turbo": "2.9.18",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
