{
  "name": "@call-to-cash/agora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Server-only Agora RTC token, Conversation AI, and transcript adapter boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src prompts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/agora.test.ts prompts/prompt-constraints.test.ts"
  },
  "dependencies": {
    "@call-to-cash/shared": "workspace:*",
    "agora-token": "2.0.5",
    "zod": "^4.0.0"
  }
}
