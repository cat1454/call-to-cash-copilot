{
  "name": "@call-to-cash/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Prisma persistence, repository, and transaction boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "prisma:format": "prisma format --config ../../prisma.config.ts",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts",
    "prisma:validate": "prisma validate --config ../../prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config ../../prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config ../../prisma.config.ts",
    "migrate:status": "prisma migrate status --config ../../prisma.config.ts",
    "seed": "pnpm prisma:generate && prisma db seed --config ../../prisma.config.ts",
    "studio": "prisma studio --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "prisma": "7.6.0"
  }
}
